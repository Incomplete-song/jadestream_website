---
// 1. 引入获取文章的方法
import { getCollection } from 'astro:content';

// 2. 获取所有文章并按日期降序排序
const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 3. 提取最新的一篇文章
const latestPost = allPosts[0];
---
<!-- 浏览器用 HTML5 标准模式渲染,必写！ -->
<!DOCTYPE html>

<html lang="zh-CN">

  <!-- <head>
  ...元数据内容...此处构成head元素，其中的内容只给浏览器看
       </head> -->

<!-- ————————————————————head元素———————————————————— -->
  <head>

    <!-- 设置浏览器解析该文档所用的编码 -->
    <meta charset="UTF-8" />

    <!-- 移动端适配，调整网页宽度与移动端宽度一致 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 浏览器标签页标题 -->
    <title>jadestream</title>

    <!-- 设置网站浏览器标签页小图标 -->
    <link rel="icon" type="image/png" href="/touxiang.png" />
  </head>

<!-- ————————————————————body（正文）元素———————————————————— -->

  <body>
    <!-- 背景层 HTML 负责"有什么"（这里有个空容器），CSS 负责"长什么样"（全屏背景图）-->
    <!-- 告诉HTML这里有个空div结构（占位），可选择在后续的CSS中渲染出图片样式 -->
    <div class="bg-wallpaper"></div>

    <!-- 便当盒容器(网页布局主题main) -->
    <main class="bento-container">
      
      <!-- ========== 左侧列 ========== -->
      <div class="col left-col">
        <div class="card profile-card">
          <div class="profile-header">
            <img src="/touxiang.png" class="avatar" alt="avatar" />
            <h2>jadestream <span>(开发ing)</span></h2>
          </div>
          <div class="nav-links">
            <p class="nav-title">GENERAL</p>
            <!-- 更新了 href 链接 -->
            <!-- href后的内容是页面代码文件名称 -->
            <!--  -->
            <a href="/recent" class="nav-item"><span class="icon">📚</span> 最近更新</a>
            <a href="/posts" class="nav-item"><span class="icon">💠</span> 所有文章</a>
            <a href="/about" class="nav-item"><span class="icon">💬</span> 关于我</a>
            <a href="/share" class="nav-item"><span class="icon">⭐</span> 推荐分享</a>
            <a href="/updatelog" class="nav-item"><span class="icon">😎</span> 更新日志</a>

          </div>
        </div>

        <!-- 动态最新文章卡片 -->
        <div class="card latest-post-card">
          <p class="card-title">最新文章</p>
          {latestPost ? (
            <a href={`/blog/${latestPost.id}/`} class="latest-post-link">
              <div class="post-info">
                <div class="post-cover" style="background-image: url('/background.png'); background-size: cover;"></div>
                <div class="post-text">
                  <h4>{latestPost.data.title}</h4>
                  <p>{latestPost.data.description}</p>
                  <span class="date">
                    {latestPost.data.pubDate.toLocaleDateString('zh-CN')}
                  </span>
                </div>
              </div>
            </a>
          ) : (
            <div class="post-info">
              <p style="color: #888; font-size: 0.9rem;">暂无文章，快去写一篇吧！</p>
            </div>
          )}
        </div>
      </div>

      <!-- ========== 中间列 ========== -->
      <div class="col center-col">
        <div class="card gallery-card">
          <div class="gallery-inner">
            <div class="img-placeholder" style="background: #ffe4e1;">🐱</div>
            <div class="img-placeholder" style="background: #e0ffff;">🌻</div>
            <div class="img-placeholder" style="background: #f5f5dc;">📎</div>
          </div>
        </div>

        <!-- 中间问好卡片 -->
        <div class="card greeting-card">
          <div class="greeting-avatar">
            <img src="/touxiang.png" alt="头像" />
          </div>
          <h1 class="greeting-text" id="greeting">Good Morning</h1>
          <h2 class="name-text">I'm <span>Jade</span>, Nice to meet you!</h2>
          
          <div class="social-links">
            <!-- GitHub 官方图标 -->
            <a href="" target="_blank" class="social-btn github" title="GitHub">
              <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
              </svg>
            </a>
            
            <!-- 网易云官方标准图标 -->
            <a href="" target="_blank" class="social-btn netease" title="网易云音乐">
              <svg viewBox="0 0 1024 1024" width="20" height="20" fill="currentColor">
                <path d="M512 0c282.763 0 512 229.237 512 512s-229.237 512-512 512S0 794.763 0 512 229.237 0 512 0zm0 80.835C273.835 80.835 80.835 273.835 80.835 512S273.835 943.165 512 943.165 943.165 750.165 943.165 512 750.165 80.835 512 80.835zm93.866 660.097c-21.739 15.236-59.775 22.59-92.987 22.59-69.378 0-122.882-33.923-122.882-89.358 0-57.045 41.528-87.87 107.77-92.365 44.288-3.023 74.042-15.504 74.042-41.215 0-25.381-30.597-39.555-68.308-39.555-45.885 0-82.353 19.927-107.086 38.654l-35.185-57.815c30.914-24.016 81.346-48.701 146.235-48.701 88.87 0 148.155 43.32 148.155 109.313 0 78.87-63.32 104.13-137.406 108.537-38.105 2.13-53.258 10.918-53.258 28.35 0 19.014 20.685 28.643 50.246 28.643 22.72 0 48.607-6.539 64.824-17.52l27.07 51.134zm-240.456-350.12c-46.627 0-84.405 35.128-84.405 78.444 0 43.313 37.778 78.444 84.405 78.444 46.627 0 84.405-35.131 84.405-78.444 0-43.316-37.778-78.444-84.405-78.444zm0 126.108c-23.152 0-41.91-21.412-41.91-47.664 0-26.252 18.758-47.664 41.91-47.664 23.152 0 41.91 21.412 41.91 47.664 0 26.252-18.758 47.664-41.91 47.664z"></path>
              </svg>
            </a>

            <a href="#" class="social-btn xiaohongshu">书</a>
            <a href="#" class="social-btn email">✉</a>
          </div>
        </div>

        <div class="bottom-grid">
          <div class="card recommendation-card">
            <p class="card-title">随机推荐</p>
            <div class="rec-info">
              <div class="rec-icon">🎵</div>
              <div>
                <h4>Audio & Video</h4>
                <p class="desc">编解码、推流和处理链路拆开来讲...</p>
              </div>
            </div>
          </div>

          <div class="right-bottom-group">
            <div class="card music-player">
              <span class="music-icon">🎵</span>
              <div class="music-info">
                <p>Close To You</p>
                <div class="progress-bar"><div class="progress"></div></div>
              </div>
              <button class="play-btn">▶</button>
            </div>
            
            <div class="like-container">
              <button class="like-btn" id="likeBtn">
                <span class="heart">❤️</span>
                <span class="count" id="likeCount">1711</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ========== 右侧列 ========== -->
      <div class="col right-col">
        <button class="write-btn">
          <span>✍️</span> 写文章
        </button>

        <div class="card clock-card">
          <div class="digital-clock" id="clock">10:58</div>
        </div>

        <div class="card calendar-card">
          <div class="calendar-header">
            <span id="current-month">2026/10/20 周二</span>
          </div>
          <div class="calendar-grid" id="calendar-grid"></div>
        </div>
      </div>
    </main>


    <script>
      // --- 1. 问候语 & 实时时钟 ---
      function updateTime() {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        document.getElementById('clock').textContent = `${hours}:${minutes}`;

        const hour = now.getHours();
        let greeting = 'Good Evening';
        if (hour < 12) greeting = 'Good Morning';
        else if (hour < 18) greeting = 'Good Afternoon';
        document.getElementById('greeting').textContent = greeting;
      }
      updateTime();
      setInterval(updateTime, 1000);

      // --- 2. 动态日历生成 ---
      function generateCalendar() {
        const now = new Date();
        const year = now.getFullYear();
        const month = now.getMonth();
        const today = now.getDate();

        const days = ['日', '一', '二', '三', '四', '五', '六'];
        document.getElementById('current-month').textContent = `${year}/${month + 1}/${today} 周${days[now.getDay()]}`;

        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();

        const grid = document.getElementById('calendar-grid');
        grid.innerHTML = '';

        const weekDays = ['一', '二', '三', '四', '五', '六', '日'];
        weekDays.forEach(day => {
          grid.innerHTML += `<div class="cal-head">${day}</div>`;
        });

        let paddingDays = firstDay === 0 ? 6 : firstDay - 1;
        for (let i = 0; i < paddingDays; i++) {
          grid.innerHTML += `<div class="cal-empty"></div>`;
        }

        for (let i = 1; i <= daysInMonth; i++) {
          const isToday = i === today ? 'today' : '';
          grid.innerHTML += `<div class="cal-day ${isToday}">${i}</div>`;
        }
      }
      generateCalendar();

      // --- 3. 点赞交互 ---
      let likes = 1711;
      let isLiked = false;
      const likeBtn = document.getElementById('likeBtn');
      const likeCount = document.getElementById('likeCount');

      likeBtn.addEventListener('click', () => {
        if (!isLiked) {
          likes++;
          likeBtn.classList.add('liked');
        } else {
          likes--;
          likeBtn.classList.remove('liked');
        }
        isLiked = !isLiked;
        likeCount.textContent = likes;
      });
    </script>

    <style is:global>
      /* --- 全局基础样式 --- */
      :root {
        --bg-color: #f4f7f6;
        --card-bg: rgba(255, 255, 255, 0.5); /* 玻璃白 */       /*更改卡片透明度，值越大越不透明*/
        --card-border: rgba(255, 255, 255, 0.9);
        --text-main: #333;
        --text-sub: #888;
        --theme-color: #20b2aa;
        --card-radius: 24px;
        --shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow-x: hidden;
        position: relative;
      }

      /* --- 全屏壁纸层 --- */

      /*HTML 里写 class="xxx"，CSS 里就用 .xxx 来选中它*/

      .bg-wallpaper {/* 选中所有 class 为 bg-wallpaper 的元素 */
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        z-index: -1;
        background-image: url('/background.png'); 
        background-size: cover;
        background-position: center;
        filter: brightness(0.9); 
      }

      /*HTML 里写 class="xxx"，CSS 里就用 .xxx 来选中它*/

      /* --- 便当盒布局 --- */
      .bento-container {
        display: grid;
        grid-template-columns: 280px 400px 320px;
        gap: 24px;
        max-width: 1120px;
        padding: 40px 20px;
        box-sizing: border-box;
      }

      .col { display: flex; flex-direction: column; gap: 24px; }

      /* --- 通用卡片样式 --- */
      .card {
        background: var(--card-bg);
        backdrop-filter: blur(20px);                    /*更改卡片背后的图片的模糊度，值越大背后的图越模糊，卡片上的字看的越清楚*/
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--card-border);
        border-radius: var(--card-radius);
        box-shadow: var(--shadow);
        padding: 24px;
        transition: transform 0.3s ease;
      }
      
      .card:hover { transform: translateY(-4px); }

      /* --- 左侧列样式 --- */
      .profile-header { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
      .avatar {
        width: 48px; height: 48px;
        border-radius: 50%;
        object-fit: cover;
        background: #ffe4e1;
        padding: 2px;
      }
      .profile-header h2 { font-size: 1.2rem; margin: 0; display: flex; align-items: center; gap: 6px; }
      .profile-header span { font-size: 0.8rem; color: var(--theme-color); font-weight: normal; }
      
      .nav-title { font-size: 0.75rem; color: var(--text-sub); letter-spacing: 1px; margin-bottom: 12px; }
      .nav-links { display: flex; flex-direction: column; gap: 8px; }
      .nav-item {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 16px; border-radius: 16px;
        text-decoration: none; color: var(--text-main);
        font-size: 0.95rem; font-weight: 500;
        transition: background 0.2s;
      }
      .nav-item:hover { background: rgba(255,255,255,0.6); }
      .nav-item.active { background: #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.03); color: var(--theme-color); }
      .nav-item .icon { font-size: 1.2rem; }

      .latest-post-card { flex: 1; display: flex; flex-direction: column; }
      .card-title { font-size: 0.85rem; color: var(--text-sub); margin: 0 0 16px 0; }
      .post-info { display: flex; gap: 12px; align-items: center; }
      .post-cover { width: 56px; height: 56px; border-radius: 12px; flex-shrink: 0; }
      .post-text h4 { margin: 0 0 4px 0; font-size: 0.95rem; line-height: 1.4; }
      .post-text p { margin: 0 0 6px 0; font-size: 0.8rem; color: var(--text-sub); }
      .post-text .date { font-size: 0.75rem; color: #aaa; }

      .latest-post-link {
        text-decoration: none;
        color: inherit;
        display: block;
        transition: opacity 0.2s;
      }
      .latest-post-link:hover { opacity: 0.8; }

      /* --- 中间列样式 --- */
      .gallery-card { padding: 12px; height: 120px; overflow: hidden; }
      .gallery-inner { display: flex; gap: 8px; height: 100%; }
      .img-placeholder { flex: 1; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 2rem; }

      .greeting-card { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; position: relative; }
      
      .greeting-avatar { 
        width: 80px; height: 80px; border-radius: 50%; background: #fff9c4;
        display: flex; align-items: center; justify-content: center; font-size: 3rem;
        margin-bottom: 20px; box-shadow: 0 10px 20px rgba(255, 235, 59, 0.3);
        overflow: hidden; 
      }
      .greeting-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .greeting-text { font-size: 1.4rem; margin: 0 0 8px 0; font-weight: 600; color: #444;}
      .name-text { font-size: 1.3rem; margin: 0 0 24px 0; font-weight: 500; color: #555;}
      .name-text span { color: var(--theme-color); }
      
      .social-links { display: flex; gap: 12px; }
      .social-btn {
        width: 40px; height: 40px; border-radius: 12px; border: none;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; cursor: pointer; text-decoration: none; color: white;
        transition: transform 0.2s;
      }
      .social-btn:hover { transform: translateY(-3px); }
      .social-btn.github { background: #333; }
      .social-btn.netease { background: #ec4141; }
      .social-btn.xiaohongshu { background: #ff2442; }
      .social-btn.email { background: #50c8e8; }

      .bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; height: 140px; }
      .recommendation-card { display: flex; flex-direction: column; }
      .rec-info { display: flex; gap: 12px; align-items: flex-start; }
      .rec-icon { width: 40px; height: 40px; background: #fff; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05);}
      .rec-info h4 { margin: 0 0 4px 0; font-size: 0.9rem; }
      .rec-info .desc { margin: 0; font-size: 0.75rem; color: var(--text-sub); line-height: 1.4;}

      .right-bottom-group { display: flex; flex-direction: column; gap: 16px; justify-content: flex-end; }
      .music-player { display: flex; align-items: center; gap: 12px; padding: 12px 16px; }
      .music-icon { font-size: 1.2rem; color: var(--theme-color); }
      .music-info { flex: 1; }
      .music-info p { margin: 0 0 6px 0; font-size: 0.85rem; font-weight: 500; }
      .progress-bar { width: 100%; height: 4px; background: #e0e0e0; border-radius: 2px; overflow: hidden; }
      .progress { width: 40%; height: 100%; background: var(--theme-color); }
      .play-btn { width: 32px; height: 32px; border-radius: 50%; border: none; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.1); cursor: pointer; color: var(--theme-color); display: flex; align-items: center; justify-content: center;}
      
      .like-container { display: flex; justify-content: flex-start; }
      .like-btn { 
        background: rgba(255,255,255,0.8); border: none; border-radius: 20px; 
        padding: 8px 16px; display: flex; align-items: center; gap: 8px; cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05); transition: transform 0.2s;
      }
      .like-btn:active { transform: scale(0.95); }
      .like-btn .count { font-weight: bold; color: #888; }
      .like-btn.liked .heart { animation: pop 0.3s ease; }
      .like-btn.liked .count { color: #ff4d4f; }
      @keyframes pop { 0% { transform: scale(1); } 50% { transform: scale(1.4); } 100% { transform: scale(1); } }

      /* --- 右侧列样式 --- */
      .write-btn {
        background: var(--theme-color); color: white;
        border: none; border-radius: 16px; padding: 16px; font-size: 1rem; font-weight: 600;
        cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
        box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3); transition: background 0.2s;
      }
      .write-btn:hover { background: #199a93; }

      .clock-card { padding: 24px; display: flex; justify-content: center; }
      .digital-clock {
        font-family: 'Courier New', Courier, monospace;
        font-size: 3.5rem; font-weight: 700; color: #666;
        letter-spacing: 2px; background: #e6ebea; padding: 10px 20px; border-radius: 16px;
        box-shadow: inset 2px 2px 5px rgba(0,0,0,0.1), inset -2px -2px 5px rgba(255,255,255,0.8);
      }

      .calendar-card { flex: 1; }
      .calendar-header { font-size: 0.9rem; color: #666; margin-bottom: 16px; font-weight: 500;}
      .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; text-align: center; }
      .cal-head { font-size: 0.8rem; color: #aaa; margin-bottom: 8px; }
      .cal-day, .cal-empty { font-size: 0.85rem; padding: 6px 0; border-radius: 8px; color: #555;}
      .cal-day.today { background: var(--theme-color); color: white; font-weight: bold; }

      /* --- 响应式设计 --- */
      @media (max-width: 1024px) {
        .bento-container {
          grid-template-columns: 1fr;
          max-width: 500px;
        }
        .gallery-card, .bottom-grid { display: none; } 
        .left-col, .right-col, .center-col { gap: 16px; }
      }
    </style>
  </body>
</html>