    <!-- 拖拽吸附的 JS 逻辑 -->
    <script>
      const ball = document.getElementById('ball');
      const container = document.getElementById('draggableBall');
      
      let isDragging = false;
      let startX, startY;
      let currentX = window.innerWidth - 60; // 初始X坐标
      let currentY = window.innerHeight / 2; // 初始Y坐标

      // 初始化位置
      function updatePosition(x, y) {
        currentX = Math.max(0, Math.min(x, window.innerWidth - ball.offsetWidth));
        currentY = Math.max(0, Math.min(y, window.innerHeight - ball.offsetHeight));
        container.style.left = `${currentX}px`;
        container.style.top = `${currentY}px`;

        // 智能判断：如果球在屏幕下半部分，给它加个 flip 类
        if (currentY > window.innerHeight / 2) {
          container.classList.add('flip-up');
        } else {
          container.classList.remove('flip-up');
        }
      }
      updatePosition(currentX, currentY);

      // 按下鼠标开始拖拽
      ball.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX - currentX;
        startY = e.clientY - currentY;
        container.classList.remove('snap-left', 'snap-right', 'snap-top', 'snap-bottom'); // 解除吸附状态
        ball.style.cursor = 'grabbing';
      });

      // 移动鼠标
      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        updatePosition(e.clientX - startX, e.clientY - startY);
      });

      // 松开鼠标
      document.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        ball.style.cursor = 'grab';

        // 边缘吸附逻辑
        const snapDistance = 20; // 距离边缘 20px 内自动吸附
        
        // 左侧吸附
        if (currentX <= snapDistance) {
          container.classList.add('snap-left');
          updatePosition(-24, currentY); 
        } 
        // 右侧吸附
        else if (currentX >= window.innerWidth - ball.offsetWidth - snapDistance) {
          container.classList.add('snap-right');
          updatePosition(window.innerWidth - 24, currentY);
        }
        // 顶部吸附
        else if (currentY <= snapDistance) {
          container.classList.add('snap-top');
          updatePosition(currentX, -24);
        }
        // 底部吸附
        else if (currentY >= window.innerHeight - ball.offsetHeight - snapDistance) {
          container.classList.add('snap-bottom');
          updatePosition(currentX, window.innerHeight - 24);
        }
      });

      // 鼠标悬停展开（当它吸附在边缘时）
      container.addEventListener('mouseenter', () => {
        if (container.classList.contains('snap-left')) updatePosition(12, currentY);
        if (container.classList.contains('snap-right')) updatePosition(window.innerWidth - 60, currentY);
        if (container.classList.contains('snap-top')) updatePosition(currentX, 12);
        if (container.classList.contains('snap-bottom')) updatePosition(currentX, window.innerHeight - 60);
      });

      // 鼠标移出收回（当它吸附在边缘时）
      container.addEventListener('mouseleave', () => {
        if (isDragging) return;
        if (container.classList.contains('snap-left')) updatePosition(-24, currentY);
        if (container.classList.contains('snap-right')) updatePosition(window.innerWidth - 24, currentY);
        if (container.classList.contains('snap-top')) updatePosition(currentX, -24);
        if (container.classList.contains('snap-bottom')) updatePosition(currentX, window.innerHeight - 24);
      });
    </script>

    <style is:global>
      :root {
        --card-bg: rgba(255, 255, 255, 0.65); 
        --text-main: #333;
        --text-sub: #888;
        --theme-color: #20b2aa;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--text-main);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden; /* 防止拖拽时出现滚动条 */
      }

      .bg-wallpaper {
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        z-index: -1;
        background-image: url('/background.png'); 
        background-size: cover;
        background-position: center;
        filter: brightness(0.9); 
      }

      /* ================= 核心：可拖拽悬浮球 ================= */
      .floating-bookmarks {
        position: fixed;
        z-index: 999;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: left 0.3s ease, top 0.3s ease; /* 吸附时有平滑动画 */
      }

      /* 正在拖拽时取消过渡动画，实现跟手效果 */
      .floating-bookmarks:active {
        transition: none;
      }

      .bookmark-trigger {
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: grab;
        font-size: 1.2rem;
        user-select: none;
        position: relative;
        z-index: 2; /* 确保球体在列表上层 */
      }

      /* 吸附到边缘时，把圆球变成半圆 */
      .snap-left .bookmark-trigger { border-radius: 0 50% 50% 0; }
      .snap-right .bookmark-trigger { border-radius: 50% 0 0 50%; }
      .snap-top .bookmark-trigger { border-radius: 0 0 50% 50%; }
      .snap-bottom .bookmark-trigger { border-radius: 50% 50% 0 0; }

           /* ================= 展开列表（支持鼠标滚轮滑动） ================= */
      .bookmark-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        position: absolute;
        top: 60px; /* 默认向下展开 */
        transform: translateY(-10px);
        
        /* --- 核心新增：限制高度并允许滚动 --- */
        max-height: 50vh; /* 最大高度为屏幕高度的 50% */
        overflow-y: auto; /* 允许 Y 轴滚动 */
        padding: 5px; /* 留出一点内边距，防止阴影被切掉 */
        
        /* 隐藏默认的丑陋滚动条 (适配 Chrome/Safari/Edge) */
        &::-webkit-scrollbar {
          width: 0px; 
          background: transparent;
        }
        /* 适配 Firefox */
        scrollbar-width: none; 
      }

      /* 智能翻转：如果球在屏幕下半部分，改为向上展开 */
      .flip-up .bookmark-list {
        top: auto;
        bottom: 60px; /* 向上展开 */
        transform: translateY(10px);
      }

      /* 当鼠标悬停时展开 */
      .floating-bookmarks:hover .bookmark-list {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      /* ================= 页面布局 ================= */
      .bento-container {
        display: grid;
        grid-template-columns: 280px 400px;
        gap: 24px;
        max-width: 800px;
        padding: 40px 20px;
        box-sizing: border-box;
      }

      .col { display: flex; flex-direction: column; gap: 24px; }
      
      .card {
        background: var(--card-bg);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.9);
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        padding: 24px;
      }
      
      .profile-header { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
      .avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; }
      .profile-header h2 { font-size: 1.2rem; margin: 0; }
      .profile-header span { font-size: 0.8rem; color: var(--theme-color); font-weight: normal; }

      .nav-title { font-size: 0.75rem; color: var(--text-sub); margin-bottom: 12px; }
      .nav-links { display: flex; flex-direction: column; gap: 8px; }
      .nav-item {
        display: flex; align-items: center; gap: 12px;
        padding: 12px 16px; border-radius: 16px;
        text-decoration: none; color: var(--text-main);
        transition: background 0.2s;
      }
      .nav-item:hover { background: rgba(255,255,255,0.5); }

      .greeting-card { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
      .greeting-text { font-size: 1.4rem; margin: 0 0 8px 0; color: #444;}
      .name-text { font-size: 1.2rem; margin: 0; color: #555;}

      @media (max-width: 1024px) {
        .bento-container { grid-template-columns: 1fr; }
      }
    </style>
  </body>
