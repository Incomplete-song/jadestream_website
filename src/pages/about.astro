---
// 关于我页面
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>关于我 - 筠溪</title>
    <link rel="icon" type="image/png" href="/touxiang.png" />
  </head>
  <body>
    <!-- 全屏壁纸层 -->
    <div class="bg-wallpaper"></div>

    <main class="container">
      <!-- 返回按钮 -->
      <a href="/" class="back-btn">← 返回首页</a>

      <!-- 主体卡片 -->
      <div class="card">
        
        <!-- 头部：头像与基本信息 -->
        <header class="profile-header">
          <img src="/touxiang.png" class="avatar" alt="头像" />
          <div class="profile-text">
            <h1>Hi, I'm 筠溪 (jadestream)</h1>
            <p>永远想学新东西！</p>
          </div>
        </header>

        <!-- 个人简介区块 -->
        <section class="section">
          <h2 class="section-title">📝 关于我</h2>
          <p class="about-text">
            Hi，我是jadestream。这里是我的个人博客。<br>
            搭这个博客是为了记录我的学习经历，踩过的坑，以及分享各种好用的小工具✨<br>
            还有个人成长记录！🎉<br>
            这些小工具有我从网上找的开源工具，还有我自己做的(●'◡'●)<br>
            在这里，我们一起学习，共同成长 🎉。
          </p>
        </section>

        <!-- 技术栈区块 -->
        <section class="section">
          <h2 class="section-title">🛠️ 我的技术栈</h2>
          <p class="section-desc">这些是我目前正在使用和学习的技术：</p>
          
          <div class="tech-grid">
            <!-- 每一个 tech-item 就是一个技能标签 -->
            <div class="tech-item">
              <span class="tech-icon">🍔</span>
              <span class="tech-name">Python</span>
            </div>

            <div class="tech-item">
              <span class="tech-icon">🍕</span>
              <span class="tech-name">C++/C语言</span>
            </div>

            <div class="tech-item">
              <span class="tech-icon">🍳</span>
              <span class="tech-name">Javascript</span>
            </div>

            <div class="tech-item">
              <span class="tech-icon">🍟</span>
              <span class="tech-name">YOLO / OpenCV</span>
            </div>

            <div class="tech-item">
              <span class="tech-icon">🎨</span>
              <span class="tech-name">ComfyUI</span>
            </div>

            <div class="tech-item">
              <span class="tech-icon">🧂</span>
              <span class="tech-name">画PCB</span>
            </div>

            <div class="tech-item">
              <span class="tech-icon">🌭</span>
              <span class="tech-name">单片机</span>
            </div>

            <div class="tech-item">
              <span class="tech-icon">🥓</span>
              <span class="tech-name">本地部署</span>
            </div>

            <div class="tech-item">
              <span class="tech-icon">🥚</span>
              <span class="tech-name">达芬奇</span>
            </div>

            <div class="tech-item">
              <span class="tech-icon">🧇</span>
              <span class="tech-name">搭网站</span>
            </div>



          </div>
        </section>

      </div>
    </main>

    <!-- 样式部分 -->
    <style is:global>
      /* --- 全局基础设置 --- */
      :root { 
        --card-bg: rgba(255, 255, 255, 0.45); /* 高透毛玻璃 */
        --text-main: #333;
        --text-sub: #666;
        --theme-color: #20b2aa;
      }

      body { 
        margin: 0; 
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
        min-height: 100vh; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        padding: 40px 20px;
        box-sizing: border-box;
      }

      /* --- 壁纸 --- */
      .bg-wallpaper { 
        position: fixed; 
        top: 0; left: 0; width: 100vw; height: 100vh; 
        z-index: -1; 
        background-image: url('/background.png'); 
        background-size: cover; 
        background-position: center; 
        filter: brightness(0.9); 
      }
      
      /* --- 容器与卡片 --- */
      .container { width: 100%; max-width: 700px; }
      
      .card { 
        background: var(--card-bg); 
        backdrop-filter: blur(24px); 
        -webkit-backdrop-filter: blur(24px); 
        border: 1px solid rgba(255,255,255,0.8); 
        border-radius: 24px; 
        padding: 40px; 
        box-shadow: 0 10px 40px rgba(0,0,0,0.08); 
      }

      /* --- 返回按钮 --- */
      .back-btn { 
        text-decoration: none; 
        color: #fff; 
        font-size: 0.95rem; 
        display: inline-flex;
        align-items: center;
        margin-bottom: 24px; 
        background: rgba(0,0,0,0.3); 
        padding: 8px 16px;
        border-radius: 20px;
        backdrop-filter: blur(10px);
        transition: all 0.3s;
      }
      .back-btn:hover { background: rgba(0,0,0,0.5); transform: translateX(-4px); }

      /* --- 头部信息 --- */
      .profile-header { 
        display: flex; 
        align-items: center; 
        gap: 24px; 
        margin-bottom: 40px; 
        padding-bottom: 30px;
        border-bottom: 1px solid rgba(0,0,0,0.05);
      }
      
      .avatar { 
        width: 90px; height: 90px; 
        border-radius: 50%; 
        object-fit: cover; 
        border: 3px solid #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      }
      
      .profile-text h1 { 
        margin: 0 0 8px 0; 
        font-size: 1.8rem; 
        color: var(--text-main); 
      }
      .profile-text p { 
        margin: 0; 
        font-size: 1rem; 
        color: var(--text-sub); 
      }

      /* --- 内容区块 --- */
      .section { margin-bottom: 40px; }
      .section:last-child { margin-bottom: 0; }
      
      .section-title { 
        font-size: 1.25rem; 
        color: var(--text-main); 
        margin: 0 0 16px 0; 
        font-weight: 700;
      }
      
      .section-desc {
        font-size: 0.9rem;
        color: var(--text-sub);
        margin: -8px 0 16px 0;
      }

      .about-text { 
        margin: 0; 
        font-size: 1.05rem; 
        line-height: 1.8; 
        color: #444; 
      }

      /* --- 技术栈网格布局 --- */
      .tech-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 16px;
      }

      /* --- 单个技术标签卡片 --- */
      .tech-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 16px;
        transition: all 0.3s ease;
        cursor: default;
      }

      .tech-item:hover {
        background: rgba(255, 255, 255, 0.95);
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
      }

      .tech-icon {
        font-size: 1.4rem;
      }

      .tech-name {
        font-size: 0.95rem;
        font-weight: 600;
        color: #333;
      }

      /* 手机端适配 */
      @media (max-width: 600px) {
        .card { padding: 24px; }
        .profile-header { flex-direction: column; text-align: center; gap: 16px; }
        .tech-grid { grid-template-columns: repeat(2, 1fr); }
      }
    </style>
  </body>
</html>