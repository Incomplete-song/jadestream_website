---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('life');
  return posts.map(post => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} - 筠溪</title>
    <link rel="icon" type="image/png" href="/touxiang.png" />
  </head>
  <body>
    <div class="bg-wallpaper"></div>
    <main class="full-screen-glass">
      <div class="content-wrapper">
        <button onclick="history.back()" class="back-btn">← 返回上一页</button>
        
        <article class="card">
          <div class="article-cover">
            <img src={post.data.cover} alt={post.data.title} />
          </div>
          <div class="article-content">
            <header class="article-header">
              <h1 class="page-title">{post.data.title}</h1>
              <div class="meta-info">
                <span class="date">{post.data.pubDate.toLocaleDateString('zh-CN')}</span>
              </div>
            </header>
            <hr class="divider" />
            <div class="markdown-body">
              <Content />
            </div>
          </div>
        </article>
      </div>
    </main>

    <style is:global>
      :root { --card-bg: rgba(255, 255, 255, 0.5); --theme-color: #20b2aa; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: sans-serif; min-height: 100vh; color: #333; background-color: #000; }
      .bg-wallpaper { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -2; background-image: url('/background.png'); background-size: cover; background-position: center; filter: brightness(0.85); }
      .full-screen-glass { width: 100vw; min-height: 100vh; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(30px); padding: 40px 20px; display: flex; justify-content: flex-start; align-items: flex-start; flex-direction: column; }
      .content-wrapper { width: 100%; max-width: 900px; margin: 0 auto; animation: slideUpFade 0.6s ease forwards; }
      .back-btn { text-decoration: none; color: #333; font-size: 0.95rem; display: inline-flex; margin-bottom: 24px; background: rgba(255,255,255,0.6); padding: 8px 16px; border-radius: 20px; transition: all 0.3s; font-weight: 500; border: 1px solid rgba(255,255,255,0.8); cursor: pointer; font-family: inherit; }
      .back-btn:hover { background: rgba(255,255,255,0.9); transform: translateX(-4px); }
      .card { background: var(--card-bg); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.6); border-radius: 24px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.1); }
      .article-cover { width: 100%; height: 400px; }
      .article-cover img { width: 100%; height: 100%; object-fit: cover; }
      .article-content { padding: 40px; }
      .page-title { margin: 0 0 16px 0; font-size: 2.2rem; color: #1e293b; font-weight: 800; }
      .meta-info { display: flex; align-items: center; gap: 16px; color: #64748b; font-size: 0.95rem; }
      .date { font-family: monospace; }
      .divider { border: none; border-top: 1px solid rgba(0,0,0,0.08); margin: 30px 0; }
      .markdown-body :global(p) { line-height: 1.9; color: #333; margin-bottom: 1.5rem; font-size: 1.05rem; }
      .markdown-body :global(h2) { margin-top: 2rem; margin-bottom: 1rem; color: #1e293b; border-bottom: 2px solid rgba(32, 178, 170, 0.3); padding-bottom: 8px; display: inline-block; }
      .markdown-body :global(img) { max-width: 100%; border-radius: 12px; margin: 1rem 0; }
      @keyframes slideUpFade { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
      @media (max-width: 600px) { .article-cover { height: 200px; } .article-content { padding: 20px; } .page-title { font-size: 1.8rem; } }
    </style>
  </body>
</html>